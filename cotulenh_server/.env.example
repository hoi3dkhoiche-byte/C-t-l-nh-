# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG SERVER CỜ TƯ LỆNH
# Sao chép file này thành '.env' trước khi chạy:
#   cp .env.example .env
# =============================================================================

# 1. MÔI TRƯỜNG CHẠY (development | local | test | production)
# - development: Cho phép chạy SQLite hoặc MySQL local, bật debug khi chạy trực tiếp.
# - production: Bắt buộc có DATABASE_URL (MySQL/RDS) và JWT_SECRET_KEY hợp lệ; thiếu sẽ báo lỗi ngay.
APP_ENV=development

# 2. JWT AUTHENTICATION
# Khi lên production bắt buộc thay bằng chuỗi ngẫu nhiên bảo mật tối thiểu 32 ký tự:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# 3. CƠ SỞ DỮ LIỆU (DATABASE URL - Thống nhất driver PyMySQL cho MySQL/RDS)
# --- Lựa chọn A: Chạy trực tiếp trên máy local bằng SQLite (mặc định hợp lệ ngay) ---
DATABASE_URL=sqlite:///cotulenh.db

# --- Lựa chọn B: Kết nối MySQL 8.4 chạy bằng Docker local (từ máy host) ---
# DATABASE_URL=mysql+pymysql://cotulenh:cotulenh123@127.0.0.1:3306/cotulenh
# DB_SSL_MODE=DISABLED

# --- Lựa chọn C: Triển khai Production với AWS RDS MySQL (bỏ comment khi có RDS) ---
# APP_ENV=production
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:3306/<DB_NAME>
# DB_SSL_MODE=VERIFY_IDENTITY
# DB_SSL_CA=certs/global-bundle.pem
# (Trong container Docker, chứng chỉ AWS RDS đã có sẵn tại: /etc/ssl/certs/aws-rds-global-bundle.pem)

# 4. THÔNG SỐ CONNECTION POOL & TIMEOUT (Áp dụng cho MySQL / AWS RDS)
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=280

# 5. GỬI MAIL OTP (GMAIL SMTP)
# Dùng cho tính năng Quên mật khẩu. Cần bật "Mật khẩu ứng dụng" (App Password) trong Google Account.
MAIL_USERNAME=email_gui_otp@gmail.com
MAIL_APP_PASSWORD=apppassword16kytu

# 6. CẤU HÌNH THỜI GIAN GAMEPLAY (GIÂY)
TURN_SECONDS=45
RECONNECT_TIMEOUT=50
JOIN_REQUEST_TIMEOUT=20

# =============================================================================
# GHI CHÚ MẠNG & BẢO MẬT KHI TRIỂN KHAI AWS RDS MYSQL:
# 1. Tải chứng chỉ CA AWS RDS (nếu chạy ngoài Docker):
#    curl -o certs/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# 2. Mạng & VPC:
#    - Đặt RDS ở Private Subnet trong cùng VPC với EC2/ECS chạy server Flask.
#    - RDS Security Group: Chỉ mở Inbound TCP 3306 từ Security Group của tầng App Server
#      (TUYỆT ĐỐI KHÔNG mở 0.0.0.0/0 ra Internet).
# =============================================================================
