# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG SERVER CỜ TƯ LỆNH
# Sao chép file này thành '.env' trước khi chạy:
#   cp .env.example .env
# =============================================================================

# 1. JWT AUTHENTICATION
# Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự để mã hóa token
# (Chưa có thì tạm thời để mặc định, server đã có sẵn fallback dev)
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu

# 2. CƠ SỞ DỮ LIỆU (DATABASE URL)
# Khi nào tạo AWS RDS thì thay thế vào dòng dưới:
# - Đối với AWS RDS MySQL:
#   DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:3306/<DB_NAME>
# - Đối với AWS RDS PostgreSQL:
#   DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
# - Nếu chạy Docker compose local (mặc định):
#   DATABASE_URL=mysql+pymysql://cotulenh:cotulenh123@db:3306/cotulenh
DATABASE_URL=mysql+pymysql://admin:mat_khau_rds@rds-cotulenh-endpoint.amazonaws.com:3306/cotulenh

# 3. GỬI MAIL OTP (GMAIL SMTP)
# Dùng cho tính năng Quên mật khẩu. Cần bật "Mật khẩu ứng dụng" (App Password) trong Google Account.
MAIL_USERNAME=email_gui_otp@gmail.com
MAIL_APP_PASSWORD=apppassword16kytu

# =============================================================================
# GHI CHÚ BẢO MẬT AWS RDS (SECURITY GROUP):
# - RDS Security Group: Thêm Inbound Rule cho Port 3306 (MySQL) hoặc 5432 (Postgres).
# - Source: Chỉ cho phép Security Group của EC2/ECS/App Service chạy server Flask
#   hoặc IP tĩnh của server, TRÁNH mở 0.0.0.0/0 (bị scan mật khẩu).
# =============================================================================
